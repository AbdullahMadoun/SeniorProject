# Python caches
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build/test artifacts
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/

# Local secrets/config
.env
.env.*
!.env.example
.tokens/
.streamlit/secrets.toml

# Logs
*.log

# IDE/OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime data (keep folders only)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/history/
data/processed/history/*
!data/processed/history/.gitkeep

# Web bridge runtime history
src/static/history.json
src/static/history_images/*
!src/static/history_images/.gitkeep
