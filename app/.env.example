# App tuning
SKYLINK_TARGET_CLASSES=crack
SKYLINK_MIN_CRACK_AREA_RATIO=0.0001
SKYLINK_DEMO_GPS_IF_MISSING=true
SKYLINK_DEMO_CENTER_LAT=26.3073
SKYLINK_DEMO_CENTER_LON=50.1456
SKYLINK_DEMO_STEP_DEG=0.00022

# Optional bridge server settings
SKYLINK_BRIDGE_PORT=8001
SKYLINK_VLM_API_URL=

# Dashboard filtering (hide older trial records by default)
SKYLINK_BOARD_SHOW_LEGACY=false
SKYLINK_BOARD_PREFIXES=bridge_,standalone_
# Example: 2026-02-24T00:00:00Z
SKYLINK_BOARD_START_UTC=
