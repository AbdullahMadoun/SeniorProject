# App tuning
SKYLINK_TARGET_CLASSES=crack
SKYLINK_MIN_CRACK_AREA_RATIO=0.0001
SKYLINK_DEMO_GPS_IF_MISSING=true
SKYLINK_DEMO_CENTER_LAT=26.3073
SKYLINK_DEMO_CENTER_LON=50.1456
SKYLINK_DEMO_STEP_DEG=0.00022

# Optional bridge server settings
SKYLINK_BRIDGE_PORT=8001
SKYLINK_VLM_API_URL=
SKYLINK_VLM_API_KEY=
SKYLINK_ENABLE_QUICK_TUNNEL=true
SKYLINK_PUBLIC_BASE_URL=
SKYLINK_EXPOSE_VLM_API_KEY_TO_FRONTEND=false
SKYLINK_USE_BRIDGE_PROXY=true
SKYLINK_FRONTEND_DIRECT_MODEL=true

# Autonomous remote model startup
SKYLINK_REMOTE_MODEL_AUTOSTART=false
SKYLINK_REMOTE_MODEL_PROVIDER=ssh
SKYLINK_REMOTE_MODEL_SSH_HOST=
SKYLINK_REMOTE_MODEL_SSH_PORT=22
SKYLINK_REMOTE_MODEL_SSH_USER=root
SKYLINK_REMOTE_MODEL_SSH_KEY_FILE=/root/.ssh/id_ed25519
SKYLINK_REMOTE_MODEL_SSH_PUBLIC_KEY_FILE=/root/.ssh/id_ed25519.pub
SKYLINK_REMOTE_MODEL_SSH_KNOWN_HOSTS_FILE=/root/.ssh/known_hosts
SKYLINK_REMOTE_MODEL_SSH_STRICT_HOST_KEY_CHECKING=accept-new
SKYLINK_REMOTE_MODEL_REMOTE_PATH=/opt/skylink-model-server
SKYLINK_REMOTE_MODEL_API_KEY=
SKYLINK_REMOTE_MODEL_PORT=17612
SKYLINK_REMOTE_MODEL_ENABLE_VLM=true
# Blank means auto: mirrors SKYLINK_REMOTE_MODEL_ENABLE_VLM.
SKYLINK_REMOTE_MODEL_ENABLE_YOLO_V8=
SKYLINK_REMOTE_MODEL_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
SKYLINK_REMOTE_MODEL_GPU_MEM_UTIL=0.80
SKYLINK_REMOTE_MODEL_MAX_MODEL_LEN=16384
SKYLINK_REMOTE_MODEL_MAX_OUTPUT_TOKENS=16384
SKYLINK_REMOTE_MODEL_YOLO_V12=rezzzq/yolo12s-road-damage-rdd2022
SKYLINK_REMOTE_MODEL_YOLO_V8_WEIGHTS_URL=https://huggingface.co/oracl4/YOLOv8_Small_RDD/resolve/main/YOLOv8_Small_RDD.pt
SKYLINK_REMOTE_MODEL_HF_TOKEN=
SKYLINK_REMOTE_MODEL_PREFETCH=true
SKYLINK_REMOTE_MODEL_ENABLE_QUICK_TUNNEL=true
SKYLINK_REMOTE_MODEL_WAIT_FOR_HEALTH=true
SKYLINK_REMOTE_MODEL_WAIT_FOR_TUNNEL=true

# Vast.ai autonomous leasing
SKYLINK_VAST_API_KEY=
SKYLINK_VAST_INSTANCE_ID=
SKYLINK_VAST_INSTANCE_LABEL=skylink-managed-model
SKYLINK_VAST_PREFERRED_GPU_NAMES=RTX 4090,L40S,A100,H100
SKYLINK_VAST_MIN_GPU_RAM_GB=24
SKYLINK_VAST_MAX_HOURLY_USD=1.5
SKYLINK_VAST_MIN_RELIABILITY=0.97
SKYLINK_VAST_REQUIRE_VERIFIED=true
SKYLINK_VAST_SEARCH_LIMIT=25
SKYLINK_VAST_IMAGE=vastai/base-image:@vastai-automatic-tag
SKYLINK_VAST_DISK_GB=64
SKYLINK_VAST_RUNTYPE=ssh_direct
SKYLINK_VAST_OFFER_TYPE=ondemand

# Dashboard filtering (hide older trial records by default)
SKYLINK_BOARD_SHOW_LEGACY=false
SKYLINK_BOARD_PREFIXES=bridge_,standalone_
# Example: 2026-02-24T00:00:00Z
SKYLINK_BOARD_START_UTC=
