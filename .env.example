# Supabase project URL (example: https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Use Service Role key on trusted backend only (never expose on frontend/browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Storage settings
SUPABASE_BUCKET=skylink-images
SUPABASE_BUCKET_PUBLIC=true
SUPABASE_SIGNED_URL_TTL=3600

# Postgres pooler (IPv4 friendly): use the Supabase "Connection pooling" URI (transaction mode, port 6543)
# Example:
# postgresql://postgres.your_project_ref:your_password@<pooler-host-from-dashboard>:6543/postgres?sslmode=require
SUPABASE_DB_POOLER_URL=postgresql://postgres.your_project_ref:your_password@<pooler-host-from-dashboard>:6543/postgres?sslmode=require

# Optional fallback direct DB URL (often IPv6-only in some networks)
SUPABASE_DB_URL=

# App tuning
SUPABASE_DB_POOL_MIN=1
SUPABASE_DB_POOL_MAX=5
SKYLINK_TARGET_CLASSES=crack
SKYLINK_MIN_CRACK_AREA_RATIO=0.0001
SKYLINK_DEMO_GPS_IF_MISSING=true
SKYLINK_DEMO_CENTER_LAT=26.3073
SKYLINK_DEMO_CENTER_LON=50.1456
SKYLINK_DEMO_STEP_DEG=0.00022

# Optional bridge server settings
SKYLINK_BRIDGE_PORT=8001
SKYLINK_VLM_API_URL=https://essentially-contests-trip-delicious.trycloudflare.com/analyze
SKYLINK_VLM_API_KEY=road-inspector-secret-key-2024

# Dashboard filtering (hide older trial records by default)
SKYLINK_BOARD_SHOW_LEGACY=false
SKYLINK_BOARD_PREFIXES=bridge_,standalone_
# Example: 2026-02-24T00:00:00Z
SKYLINK_BOARD_START_UTC=
